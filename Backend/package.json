{
  "name": "solcacao-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SolCacao Phase 3 REST API - Express + MySQL 8",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/db-setup.js",
    "secret": "node scripts/generate-secret.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1"
  }
}
